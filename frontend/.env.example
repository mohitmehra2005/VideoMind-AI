# =============================================================================
# OpticAI Frontend Environment Configuration
# =============================================================================

# Next.js Public App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth 2.0 Client ID (for Continue with Google on Frontend)
# Create credentials in Google Cloud Console -> APIs & Services -> Credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Backend API URL (for connecting to OpticAI Python FastAPI/RAG service in Phase 2)
NEXT_PUBLIC_API_URL=http://localhost:8000
